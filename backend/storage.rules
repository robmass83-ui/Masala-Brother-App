rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function memberEmail() {
      return signedIn()
        && request.auth.token.email in
          firestore.get(/databases/(default)/documents/households/main).data.memberEmails;
    }

    match /households/{householdId}/{allPaths=**} {
      allow read: if memberEmail();
      allow write: if memberEmail()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
